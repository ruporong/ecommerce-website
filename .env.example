# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/dbname

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_key_here

# App URL & Store Details
NEXT_PUBLIC_APP_URL=http://localhost:3000
STORE_NAME="ÉLANE"

# Cloudinary (Media / Product Images)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# AI / Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Courier Integration (Steadfast / Pathao)
COURIER_API_KEY=your_steadfast_api_key
COURIER_SECRET_KEY=your_steadfast_secret_key
PATHAO_COURIER_CLIENT_ID=your_pathao_client_id
PATHAO_COURIER_SECRET_KEY=your_pathao_secret_key

# Email (SMTP / Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_app_password
SMTP_FROM=your_email@example.com

# Upstash Redis & Rate Limiting (Optional)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Cron Jobs (e.g. Abandoned Cart Cron)
CRON_SECRET=your_cron_secret_token
